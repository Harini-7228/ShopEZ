# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────
# Use a MongoDB Atlas connection string for production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopez?retryWrites=true&w=majority

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_strong_access_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────
# Set this to your Vercel frontend URL (no trailing slash)
CORS_ORIGIN=https://your-shopez-app.vercel.app

# ─── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
