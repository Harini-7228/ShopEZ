# ─── Express Server Configuration ────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Connection URI ───────────────────────────────────
# Replace with your own MongoDB Atlas or local URI
# Atlas format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGO_URI=mongodb://localhost:27017/shopez

# ─── JWT Secrets ─────────────────────────────────────────────
# Generate strong random strings for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_key
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_key

# ─── Token Expiry ─────────────────────────────────────────────
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS Origin ──────────────────────────────────────────────
# Point to your frontend URL (Vite dev server or production domain)
CORS_ORIGIN=http://localhost:5173
