{
  "name": "shopez-root",
  "version": "1.0.0",
  "description": "Root configuration for running client and server concurrently",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run client\" \"npm run server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
