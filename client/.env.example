# ─── API ──────────────────────────────────────────────────────
# For local development: leave as /api/v1 (Vite proxy handles it)
# For production (Vercel): set to your full Render backend URL
VITE_API_URL=https://your-shopez-backend.onrender.com/api/v1

# ─── Razorpay ─────────────────────────────────────────────────
# Use rzp_test_... for test mode, rzp_live_... for production payments
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
